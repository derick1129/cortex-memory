# CortexMemory Environment Variables
CORTEX_POSTGRES_URL=postgresql://cortex:cortex_secure_password@localhost:5432/cortex_memory
CORTEX_NEO4J_URI=bolt://localhost:7687
CORTEX_NEO4J_USER=neo4j
CORTEX_NEO4J_PASSWORD=cortex_secure_password
CORTEX_WORKING_MEMORY_TOKEN_CAP=4000
CORTEX_CONTEXT_BUDGET_CEILING=2500
CORTEX_RRF_K=60
CORTEX_WEIGHT_VECTOR=1.0
CORTEX_WEIGHT_GRAPH=1.2
CORTEX_WEIGHT_EPISODIC=0.8
CORTEX_LLM_MODEL=claude-3-5-haiku-20241022
CORTEX_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CORTEX_EMBEDDING_DIMENSION=1536
